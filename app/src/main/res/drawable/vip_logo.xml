<?xml version="1.0" encoding="utf-8"?>
<!--
  Stilisierte Vektor-Annäherung an das SWP/ViP-Windrad: vier geschwungene
  Windrad-Flügel in den Logofarben, die sich in der Mitte treffen. Für das
  finale Branding bitte durch das offizielle Logo aus dem Markenportal
  ersetzen (Android Studio: File > New > Vector Asset, dann diese Datei
  überschreiben) - siehe README, Abschnitt "Splitscreen & Branding".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:rotation="12"
        android:pivotX="54"
        android:pivotY="54">
        <!-- oben links: Rot -->
        <group android:rotation="0" android:pivotX="54" android:pivotY="54">
            <path
                android:fillColor="#D5232A"
                android:pathData="M54,54 C54,26 40,8 12,8 C12,36 26,54 54,54 Z" />
        </group>
        <!-- oben rechts: Blau -->
        <group android:rotation="90" android:pivotX="54" android:pivotY="54">
            <path
                android:fillColor="#1467A8"
                android:pathData="M54,54 C54,26 40,8 12,8 C12,36 26,54 54,54 Z" />
        </group>
        <!-- unten rechts: Orange -->
        <group android:rotation="180" android:pivotX="54" android:pivotY="54">
            <path
                android:fillColor="#F39200"
                android:pathData="M54,54 C54,26 40,8 12,8 C12,36 26,54 54,54 Z" />
        </group>
        <!-- unten links: Grün -->
        <group android:rotation="270" android:pivotX="54" android:pivotY="54">
            <path
                android:fillColor="#41A62A"
                android:pathData="M54,54 C54,26 40,8 12,8 C12,36 26,54 54,54 Z" />
        </group>
    </group>
</vector>
